<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="10dp"
        android:text="副屏投屏位置调整"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_pos_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="6dp"
        android:text="当前位置: X = 0 px, Y = 0 px"
        android:textColor="#88FFFFFF"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- =====[MOD-BEGIN]副屏模块自定义系统：左侧模块列表===== -->
        <LinearLayout
            android:layout_width="130dp"
            android:layout_height="match_parent"
            android:background="#16213E"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="6dp"
                android:text="可用模块"
                android:textColor="#4FC3F7"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/module_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/tv_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:text="点击添加，可重复添加"
                android:textColor="#888888"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btn_clear_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_scale_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="清空所有模块"
                android:textColor="#FF6B6B"
                android:textSize="12sp" />
        </LinearLayout>
        <!-- =====[MOD-END]===== -->

        <!-- 右侧：模拟副屏 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#0F0F1A"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/mock_screen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#2A2A4A"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </FrameLayout>
    </LinearLayout>

    <!-- =====[MOD-BEGIN]副屏模块自定义系统：底部调位按键===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btn_pos_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_scale_btn"
            android:gravity="center"
            android:padding="12dp"
            android:text="◀"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_pos_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_scale_btn"
            android:gravity="center"
            android:padding="12dp"
            android:text="▲"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_pos_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_scale_btn"
            android:gravity="center"
            android:padding="12dp"
            android:text="居中"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_pos_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_scale_btn"
            android:gravity="center"
            android:padding="12dp"
            android:text="▼"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_pos_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_scale_btn"
            android:gravity="center"
            android:padding="12dp"
            android:text="▶"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_pos_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scale_btn"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="保存并退出"
            android:textColor="#4FC3F7"
            android:textSize="13sp" />
    </LinearLayout>
    <!-- =====[MOD-END]===== -->
</LinearLayout>
