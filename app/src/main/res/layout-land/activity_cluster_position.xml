<?xml version="1.0" encoding="utf-8"?>
<!-- [MOD-BEGIN]V13.6：横屏——标题固定顶部 + 按钮固定底部（任何分辨率不丢失） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF16181F">

    <!-- 中间内容区（上下为标题条/按钮条留空间） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingBottom="56dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 左列：模拟屏 + D-Pad -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/mock_screen"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:padding="6dp" />

                <!-- D-Pad 方向键 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="6dp">

                    <TextView
                        android:id="@+id/btn_pos_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_scale_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="◀"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btn_pos_up"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_scale_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="▲"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btn_pos_center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_scale_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="居中"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_pos_down"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_scale_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="▼"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btn_pos_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_scale_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="▶"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 右列：可用模块列表 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="4dp"
                    android:text="可用模块"
                    android:textColor="#8FD0E8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/module_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 顶部标题条（固定顶部） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF16181F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="副屏投屏位置调整"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_cluster_pos_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前位置: X = 0 px, Y = 0 px"
            android:textColor="#88FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 底部按钮条（固定底部，永不丢失） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FF16181F"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/btn_pos_done"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_scale_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="10dp"
            android:text="保存"
            android:textColor="#4FC3F7"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_pos_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_scale_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="10dp"
            android:text="取消"
            android:textColor="#FF8A8A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_clear_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_scale_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="10dp"
            android:text="清空模块"
            android:textColor="#FF6B6B"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
<!-- [MOD-END] -->
